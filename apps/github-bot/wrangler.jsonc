{
  // Set WEBHOOK_SECRET, ADMIN_TOKEN, ARTIFACT_TOKEN, APP_ID, and PRIVATE_KEY with `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flareport-github-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareport-github-bot",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
