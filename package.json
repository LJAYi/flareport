{
  "name": "flareport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-maintained Cloudflare deployment adapters for open-source projects",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "flareport": "./src/cli.ts"
  },
  "scripts": {
