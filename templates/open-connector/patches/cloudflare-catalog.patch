index 00000000..852b99c5
--- /dev/null
+++ b/src/server/cloudflare/bundled-catalog.test.ts
@@ -0,0 +1,91 @@
+import type { ProviderDefinition } from "../../core/types.ts";
+
+import { describe, expect, it } from "vitest";
+import { createCatalogStore } from "../../catalog-store.ts";
+import { prepareBundledCatalog, withCatalogAssetScope } from "./bundled-catalog.ts";
+
+const provider: ProviderDefinition = {
+  service: "example",
+  displayName: "Example",
+  categories: ["Developer Tools"],
+  authTypes: ["no_auth"],
+  auth: [{ type: "no_auth" }],
+  actions: [
+    {
+      id: "example.ping",
+      service: "example",
+      name: "ping",
+      operationType: "read",
+      description: "Ping",
+      requiredScopes: [],
+      providerPermissions: [],
+      inputSchema: { type: "object" },
+      outputSchema: {},
+    },
+  ],
+};
+
+describe("bundled Cloudflare catalog", () => {
+  it("coalesces concurrent details within one request without sharing pending reads across requests", async () => {
+    let attempts = 0;
+    const catalog = prepareBundledCatalog(
+      [provider],
+      {},
+    )({
+      fetch: async () => {
+        attempts++;
+        return Response.json(provider);
+      },
+    });
+    await Promise.all(
+      [1, 2].map(() =>
+        withCatalogAssetScope(async () => {
+          await Promise.all(Array.from({ length: 60 }, () => catalog.getAction("example.ping")));
+        }),
+      ),
+    );
+    expect(attempts).toBe(2);
+  });
+  it("prepares both list locales without asset reads and loads schemas only on explicit detail requests", async () => {
+    const metadata = [
+      {
+        ...provider,
+        actions: provider.actions.map(({ inputSchema: _input, outputSchema: _output, ...action }) => action),
+      },
+    ];
+    const options = { executableActionIds: ["example.ping"] };
+    const bind = prepareBundledCatalog(metadata, options);
+    const reads: string[] = [];
+    const catalog = bind({
+      fetch: async (request) => {
+        reads.push(new URL(request.url).pathname);
+        return Response.json(provider);
+      },
+    });
+    const eager = createCatalogStore([provider], options);
+    for (const locale of ["en", "zh-CN"] as const) {
+      expect(catalog.getProviderDisplay(locale)).toEqual(eager.getProviderDisplay(locale));
+    }
+    expect(reads).toEqual([]);
+    expect(await catalog.getAction("missing.ping")).toBeUndefined();
+    expect(await catalog.getAction("example.ping")).toEqual(await eager.getAction("example.ping"));
+    await catalog.getAction("example.ping");
+    expect(reads).toEqual(["/catalog/providers/example.json"]);
+  });
+
+  it("retries failed asset reads instead of caching a rejected promise", async () => {
+    let attempts = 0;
+    const catalog = prepareBundledCatalog(
+      [provider],
+      {},
+    )({
+      fetch: async () => {
+        if (++attempts === 1) return new Response("unavailable", { status: 503 });
+        return Response.json(provider);
+      },
+    });
+    await expect(catalog.getAction("example.ping")).rejects.toThrow("returned 503");
+    expect((await catalog.getAction("example.ping"))?.inputSchema).toEqual({ type: "object" });
+    expect(attempts).toBe(2);
+  });
+});
diff --git a/src/server/cloudflare/bundled-catalog.ts b/src/server/cloudflare/bundled-catalog.ts
new file mode 100644
index 00000000..55836bf3
--- /dev/null
+++ b/src/server/cloudflare/bundled-catalog.ts
@@ -0,0 +1,61 @@
+import type { CatalogProviderMetadata, CatalogStore, ExecutableActionOptions } from "../../catalog-store.ts";
+import type { ProviderDefinition } from "../../core/types.ts";
+import type { AssetsBinding } from "./cloudflare-bindings.ts";
+
+import { AsyncLocalStorage } from "node:async_hooks";
+import { createCatalogFromMetadata, resolveExecutableActionIds } from "../../catalog-store.ts";
+import { readJsonAsset } from "./catalog-assets.ts";
+
+const requestReads = new AsyncLocalStorage<Map<string, Promise<unknown>>>();
+
+/** Coalesce schema reads only within one request, never across request lifetimes. */
+export function withCatalogAssetScope<T>(run: () => Promise<T>): Promise<T> {
+  return requestReads.run(new Map(), run);
+}
+
+/** Prepare immutable list data during isolate startup, not within a Free-plan request's CPU budget. */
+export function prepareBundledCatalog(
+  providers: CatalogProviderMetadata[],
+  options: ExecutableActionOptions,
+): (assets: AssetsBinding) => CatalogStore {
+  const prepared = createCatalogFromMetadata(
+    providers,
+    async () => {
+      throw new Error("Action schemas require an assets binding");
+    },
+    { executableActionIds: resolveExecutableActionIds(providers, options) },
+  );
+  prepared.getProviderDisplay("zh-CN");
+
+  return (assets) => {
+    // Cache settled data only: an interrupted request must not strand other requests on its promise.
+    const cache = new Map<string, ProviderDefinition>();
+    return {
+      ...prepared,
+      async getAction(id) {
+        const summary = prepared.actionsById.get(id);
+        if (!summary) return undefined;
+        const service = summary.service;
+        let provider = cache.get(service);
+        if (!provider) {
+          const reads = requestReads.getStore();
+          let pending = reads?.get(service);
+          if (!pending) {
+            pending = readJsonAsset(assets, `/catalog/providers/${encodeURIComponent(service)}.json`);
+            reads?.set(service, pending);
+          }
+          provider = (await pending) as ProviderDefinition;
+          if (provider.service !== service || !Array.isArray(provider.actions)) {
+            throw new Error(`Invalid catalog provider asset: ${service}`);
+          }
+        }
+        cache.delete(service);
+        cache.set(service, provider);
+        if (cache.size > 64) cache.delete(cache.keys().next().value!);
+        const action = provider.actions.find((action) => action.id === id);
+        if (!action) throw new Error(`Catalog action ${id} is missing from ${service}`);
+        return { ...action, ...summary };
+      },
+    };
+  };
+}
