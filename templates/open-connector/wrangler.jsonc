{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-connector",
  "main": ".flareport/upstream/src/server/cloudflare.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": false,
  "keep_vars": true,
  "cache": { "enabled": true },
  "assets": {
    "directory": ".flareport/upstream/dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/.well-known/*", "/api/*", "/v1/*", "/mcp*", "/oauth/*", "/docs", "/docs/*", "/openapi.json", "/health"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-connector",
      "migrations_dir": ".flareport/upstream/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TRANSIT_FILES"
    }
  ]
}
